---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Open-source, self-hosted data warehouse compatible with Snowflake SQL" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --snow: #f8fafc;
    --midnight: #0f172a;
    --blue: #3b82f6;
    --slate: #64748b;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--snow);
    color: var(--midnight);
    line-height: 1.6;
  }

  code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    background: #e2e8f0;
    padding: 0.2em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }

  pre {
    background: var(--midnight);
    color: var(--snow);
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
  }

  pre code {
    background: none;
    padding: 0;
    font-size: 0.875rem;
  }
</style>
